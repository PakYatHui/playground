# Compose project name used in container naming.
COMPOSE_PROJECT_NAME=playground

# Set the server timezone for the container runtime.
TZ=UTC

# Host and container ports exposed by docker compose.
HOST_PORT=3000
CONTAINER_PORT=3000

# Replace this with the real start command once application code exists.
APP_START_COMMAND=echo "Replace APP_START_COMMAND with the real app startup command" && tail -f /dev/null
